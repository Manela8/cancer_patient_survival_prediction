__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ===== Virtual environments =====
venv/
env/
.venv/
ENV/

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Streamlit =====
